SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Vertex uses Application Default Credentials locally and the service account in Cloud Run.
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=global
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
GEMINI_SUPPORT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Apply the 20261010 migrations before enabling jobs. Requires always-on CPU and min instances >= 1.
JOBS_ENABLED=false
# Shared limits are mandatory in production; optionally exercise locally against a test database.
SHARED_LIMITS_ENABLED=false
# Set only after confirming the exact trusted proxy chain. 0 ignores forwarded headers.
TRUST_PROXY_HOPS=0
PORT=8080

# Optional; requires jobs, all migrations, and validated production pricing.
BILLING_ENABLED=false
