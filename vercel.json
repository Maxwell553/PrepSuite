{
  "rewrites": [
    {
      "source": "/((?!EmailLogo\\.jpg$|.*\\.(jpg|jpeg|png|gif|ico|svg|css|js|json|woff2?)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
