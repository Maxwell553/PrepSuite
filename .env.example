# Supabase Configuration (Required)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Pipeline Service (for local dev)
# The Vite dev server proxies /api/* to the pipeline-service. For local development:
# 1. Copy pipeline-service/.env.example to pipeline-service/.env and fill in values
# 2. Run: cd pipeline-service && npm run dev
# 3. Run: npm run dev (in project root)
# Leave empty for local dev (proxy handles it); set for production Cloud Run URL
# VITE_PIPELINE_SERVICE_URL=

# Sentry Error Tracking (Optional - for production)
VITE_SENTRY_DSN=your-sentry-dsn-here
VITE_SENTRY_ENABLE_DEV=false

# Note: GEMINI_API_KEY is set as a Supabase secret, not an environment variable
# Set it using: supabase secrets set GEMINI_API_KEY=your-key